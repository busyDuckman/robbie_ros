# Settings for just setup-flash. just setup-flash asks for anything missing and saves it to .env.
# .env is gitignored. It holds the WiFi password in plain text.

ROBBIE_HOSTNAME=robbie-ros          # the Pi is reachable as <hostname>.local
ROBBIE_USER=robbie
ROBBIE_WIFI_SSID=
ROBBIE_WIFI_PASSWORD=
ROBBIE_WIFI_COUNTRY=                # two-letter code, e.g. AU, GB, US
ROBBIE_SSH_PUBKEY=                  # defaults to ~/.ssh/id_ed25519.pub
ROBBIE_PASSWORD_HASH=               # console login fallback; set from a prompt, never typed here
