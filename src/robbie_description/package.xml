<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robbie_description</name>
  <version>0.0.1</version>
  <description>Robbie's URDF (the three sled joints, with the ros2_control block), the neck geometry, and the MuJoCo model built from it.</description>
  <maintainer email="the.duckman@gmail.com">busyDuckman</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <build_depend>python3-yaml</build_depend>

  <exec_depend>xacro</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
