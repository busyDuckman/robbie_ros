<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robbie_viz</name>
  <version>0.0.1</version>
  <description>Logs the neck to Rerun (ADR 1). rerun-sdk comes from the dev container's venv, not rosdep.</description>
  <maintainer email="the.duckman@gmail.com">busyDuckman</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>robbie_neck</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
